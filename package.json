{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "wrangler dev --config wrangler.jsonc",
    "preview": "wrangler dev --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deploy": "pnpm build && pnpm deploy:built",
    "deploy:built": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "katex": "0.18.7",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "wrangler": "4.129.1"
  },
  "type": "module"
}
