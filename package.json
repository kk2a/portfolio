{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "wrangler dev --config wrangler.jsonc",
    "preview": "wrangler dev --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deploy": "pnpm build && pnpm deploy:built",
    "deploy:built": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "katex": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/katex": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "^9.39.5",
    "eslint-config-next": "latest",
    "typescript": "^5.9.3",
    "wrangler": "latest"
  },
  "type": "module"
}
